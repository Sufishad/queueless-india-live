<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: permits cleartext traffic for local testing / LAN -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Production QueueLess domain pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">queueless.in</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
