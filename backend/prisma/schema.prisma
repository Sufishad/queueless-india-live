// Prisma Schema for QueueLess India
// Database: PostgreSQL 15+
// Timezone Authority: UTC in storage, Asia/Kolkata for business day rollovers

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum BusinessCategory {
  CLINIC
  SALON
  BANK
  GOVT
  LAB
  RETAIL
}

enum BranchStatus {
  LIVE
  PAUSED
  CLOSED
}

enum TokenSource {
  APP
  WALKIN
}

enum TokenStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum TokenPriority {
  NORMAL
  SENIOR
  EMERGENCY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id         String     @id @default(uuid())
  mobile     String     @unique @db.VarChar(15)
  name       String?    @db.VarChar(100)
  lang       String     @default("en") @db.VarChar(5) // en | hi | mr
  roles      UserRole[] @default([CUSTOMER])
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime?  @map("last_seen_at") @db.Timestamptz(6)

  businesses    Business[]     @relation("BusinessOwner")
  tokens        Token[]        @relation("CustomerTokens")
  notifications Notification[]
  reviews       Review[]

  @@map("users")
}

model Business {
  id              String           @id @default(uuid())
  name            String           @db.VarChar(150)
  category        BusinessCategory
  ownerUserId     String           @map("owner_user_id")
  isVerified      Boolean          @default(false) @map("is_verified")
  complianceFlags Json             @default("{\"kyc\": false, \"gst\": false, \"datasafe\": true}") @map("compliance_flags")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  owner    User     @relation("BusinessOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  branches Branch[]

  @@map("businesses")
}

model Branch {
  id         String       @id @default(uuid())
  businessId String       @map("business_id")
  name       String       @db.VarChar(150)
  city       String       @db.VarChar(50)
  area       String       @db.VarChar(100)
  lat        Decimal      @db.Decimal(10, 7)
  lng        Decimal      @db.Decimal(10, 7)
  address    String       @db.Text
  openHours  Json         @map("open_hours") // e.g. {"open": "09:00", "close": "20:00"}
  timezone   String       @default("Asia/Kolkata") @db.VarChar(50)
  status     BranchStatus @default(LIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services      Service[]
  counters      Counter[]
  tokens        Token[]
  queueSettings QueueSettings?
  reviews       Review[]
  dailyStats    DailyQueueStats[]
  apiKeys       MerchantApiKey[]

  @@index([city, status])
  @@index([lat, lng])
  @@map("branches")
}

model Service {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  name           String   @db.VarChar(100)
  avgDurationMin Int      @map("avg_duration_min")
  priceInr       Decimal  @default(0.00) @db.Decimal(10, 2) @map("price_inr")
  isActive       Boolean  @default(true) @map("is_active")
  sortOrder      Int      @default(0) @map("sort_order")

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tokens Token[]

  @@map("services")
}

model Counter {
  id        String  @id @default(uuid())
  branchId  String  @map("branch_id")
  label     String  @db.VarChar(50) // "Counter 1", "Billing Desk"
  staffName String  @map("staff_name") @db.VarChar(100) // "Dr. Arvind", "Sneha P"
  isActive  Boolean @default(true) @map("is_active")

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tokens Token[] @relation("CalledCounter")

  @@map("counters")
}

model Token {
  id              String        @id @default(uuid())
  branchId        String        @map("branch_id")
  serviceId       String        @map("service_id")
  date            DateTime      @db.Date // Stored as IST calendar date YYYY-MM-DD
  number          Int // Resets to 1 per branch per IST day
  customerUserId  String?       @map("customer_user_id") // Null for walk-in keypad-phone customers
  source          TokenSource   @default(APP)
  status          TokenStatus   @default(WAITING)
  priority        TokenPriority @default(NORMAL)
  calledCounterId String?       @map("called_counter_id")
  calledAt        DateTime?     @map("called_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  skipCount       Int           @default(0) @map("skip_count") // 0 -> 1 on first skip (re-queue), 2 -> CANCELLED
  idempotencyKey  String?       @map("idempotency_key") @db.VarChar(64)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service       Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  customer      User?     @relation("CustomerTokens", fields: [customerUserId], references: [id], onDelete: SetNull)
  calledCounter Counter?  @relation("CalledCounter", fields: [calledCounterId], references: [id], onDelete: SetNull)
  payments      Payment[]

  // Critical Hard Rule: Duplicate token numbers per branch per day is a P0 bug
  @@unique([branchId, date, number], name: "branch_date_number_unique")
  @@index([branchId, date, status])
  @@index([customerUserId, date])
  @@index([idempotencyKey])
  @@map("tokens")
}

model QueueSettings {
  branchId         String    @id @map("branch_id")
  isPaused         Boolean   @default(false) @map("is_paused")
  voiceHi          Boolean   @default(true) @map("voice_hi")
  voiceEn          Boolean   @default(true) @map("voice_en")
  avgServiceEmaMin Float     @default(15.0) @map("avg_service_ema_min") // Seeded from service config, updated via EMA
  lastHeartbeatAt  DateTime? @map("last_heartbeat_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("queue_settings")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String    @db.VarChar(50)
  payloadJson Json      @map("payload_json")
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

// v1.5 Additive Model: Payments
model Payment {
  id           String        @id @default(uuid())
  tokenId      String        @map("token_id")
  amountInr    Decimal       @db.Decimal(10, 2) @map("amount_inr")
  method       String        @db.VarChar(50) // UPI, CARD, NETBANKING
  status       PaymentStatus @default(PENDING)
  refundStatus String?       @map("refund_status") @db.VarChar(50)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// v1.5 Additive Model: Reviews
model Review {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  userId    String   @map("user_id")
  rating    Int      @db.SmallInt // 1 to 5
  text      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// Milestone 3 Additive Model: Daily Queue Historical Aggregates & Analytics
model DailyQueueStats {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  date           DateTime @db.Date
  totalIssued    Int      @default(0) @map("total_issued")
  totalServed    Int      @default(0) @map("total_served")
  totalCancelled Int      @default(0) @map("total_cancelled")
  totalNoShow    Int      @default(0) @map("total_no_show")
  avgWaitMin     Float    @default(0.0) @map("avg_wait_min")
  avgServiceMin  Float    @default(0.0) @map("avg_service_min")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date], name: "branch_date_stats_unique")
  @@map("daily_queue_stats")
}

// Milestone 3 Additive Model: Merchant Console API Keys (in addition to JWT)
model MerchantApiKey {
  id         String    @id @default(uuid())
  branchId   String    @map("branch_id")
  keyHash    String    @unique @map("key_hash") @db.VarChar(64) // SHA-256 hash of API key
  label      String    @db.VarChar(100)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("merchant_api_keys")
}
